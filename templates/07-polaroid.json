         "en": "Let's keep\nin touch!",
         "fr": "Restons\nen contact !",
         "es": "¡Sigamos\nen contacto!",
         "it": "Restiamo\nin contatto!",
         "de": "Bleiben wir\nin Kontakt!",
         "nl": "Laten we\ncontact houden!",
